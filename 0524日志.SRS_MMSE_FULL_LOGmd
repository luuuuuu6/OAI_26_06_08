#### 优化策略：Early-exit + 向量化

```python
def load_gt_minimal(gt_dir, srs_max_slot):
    """只加载覆盖 SRS 范围的前几个 GT 文件（而非全部 241 个）"""
    for np_path in npzs:
        d = np.load(np_path)
        mask = (bp == 0)  # 正确布尔掩码
        H_all.append(H[mask][:, 0])  # squeeze symbol dim
        if slots[-1] > srs_max_slot + 200:
            break  # 提前退出

def nmse_vec(H_srs, H_gt):
    """完全向量化 NMSE（无 Python for 循环）"""
    alpha = np.sum(np.conj(Hg) * Hs, axis=-1) / (np.sum(np.conj(Hg) * Hg, axis=-1) + 1e-30)
    aligned = alpha[..., np.newaxis] * Hg
    err_pf = np.mean(np.abs(Hs - aligned)**2, axis=(1,2,3))
    sig_pf = np.mean(np.abs(aligned)**2, axis=(1,2,3))
    nmse = 10*np.log10(np.mean(err_pf) / (np.mean(sig_pf) + 1e-30))
```

