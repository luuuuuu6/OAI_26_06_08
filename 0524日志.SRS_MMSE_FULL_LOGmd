// Pass 2: per-band innovation accumulation (替代全局 innov_accum)
float band_innov[8] = {0};
int   band_count[8] = {0};
const int n_bands = 8;
const int bsz = active_sc / n_bands;

for (int k = 0; k < active_sc; k++) {
