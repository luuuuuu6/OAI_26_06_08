class IBVSS_EMA:
    def __init__(self, n_sc, c_model=0.0, alpha_init=0.5,
                 alpha_min=0.02, alpha_max=0.98, innov_ema=0.15,
                 warmup_frames=20, adaptive_cmodel=True, n_bands=8):
        ...
    def update(self, H_obs):
        # ① De-rotation
        inner = np.sum(H_obs * np.conj(self.H_main))
        rot = inner / abs(inner)
        # ② Even-odd pair → R_est (with relative eps fix)
        eps = max(p_plus * 1e-8, 1e-30)         # ← P1B 关键修复
        pm_corr = max(p_minus - self._c_model_est, eps)
        R_est = pm_corr * 2.0
        # ③ Innovation power (P4 改进: per-band median)
        innovation = H_derot - self.H_main
        # n_bands=8: 频域分 8 段取 median，抑制频域形状失配
        innov_power = np.median([np.mean(|innov[band]|²) for band in bands])
        # ④ Smooth + Kalman mapping (warmup 后启用)
        ratio = self._innov_smooth / max(R_est, eps)
        if self._frame_count > self.warmup_frames:
            alpha_raw = 1.0 - 1.0 / max(ratio, 1.001)
            self.alpha = clip(alpha_raw, alpha_min, alpha_max)
        # ⑤ EMA update
        self.H_main += self.alpha * innovation
        # ⑥ Adaptive c_model (frame 3 起更新)
        if self.adaptive_cmodel and self._frame_count >= 3:
            c_raw = mean|H_main[even] - H_main[odd]|² / 4
            noise_bias = α / (2·(2-α)) · R_est
            self._c_model_est = max(0, c_raw - noise_bias)
```

