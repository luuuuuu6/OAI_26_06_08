    float diff_r = derot_r - st->r;
    float diff_i = derot_i - st->i;
    band_innov[b] += diff_r*diff_r + diff_i*diff_i;
    band_count[b]++;
    // EMA update
    st->r += alpha * diff_r;
    st->i += alpha * diff_i;
}
// Per-band power + insertion sort → median
float bp[8];
for (int b = 0; b < n_bands; b++)
    bp[b] = band_count[b] > 0 ? band_innov[b] / band_count[b] : 0.0f;
// 8-element insertion sort for median(bp[3], bp[4])
float sorted[8]; memcpy(sorted, bp, 32);
for (int i = 1; i < n_bands; i++) { ... }  // standard insertion sort
innov_power = 0.5f * (sorted[3] + sorted[4]);
```

**2. Scalar Kalman 完整 C 移植**（新增 `update_scalarkalman_core()` ~200 行）：

```c
typedef struct {
  float K;               /* Kalman gain (equivalent to alpha) */
  float P;               /* posterior covariance */
  float Q;               /* process noise estimate */
  float innov_smooth;
  float c_model_est;
  uint32_t frame_count;
  uint32_t fallback_count;
  uint8_t initialized;
} kalman_state_t;

static kalman_state_t g_kalman_state[MAX_ANT_PAIRS * MAX_SC];
```

核心逻辑：
```c
void update_scalarkalman_core(int16_t *in, int16_t *state, ...) {
    // Pass 1: inner product + even-odd R_est (同 IBVSS)
    // c_capped = fminf(c_model_est, p_minus * 0.8f)  // Kalman 特有
    
    // Pass 2: per-band innovation + EMA update + Kalman state update
    // Per-band median for innovation (同 IBVSS P4)
    
    // Post-pass: Riccati recursion + IAE Q estimation
    float P_pred = kst->P + kst->Q;                    // predict
    float K_new = P_pred / (P_pred + R_est + 1e-30f);  // gain
    K_new = fmaxf(g_kalman_alpha_min, fminf(g_kalman_alpha_max, K_new));
    kst->P = (1.0f - K_new) * P_pred;                  // posterior
    
    // IAE: bilateral EMA + Q_floor (P2 fix)
    float Q_raw = kst->innov_smooth - kst->P - R_est;  // 允许负值
    kst->Q = (1.0f - g_kalman_q_ema) * kst->Q + g_kalman_q_ema * Q_raw;
    float Q_floor = R_est * 0.001f;
    kst->Q = fmaxf(kst->Q, Q_floor);                   // 防止锁死
    
    kst->K = K_new;  // 用于下一帧的 EMA update
}
```

